# Copy to .env and fill in your values. Never commit .env.

# Chat bot: API key (Gap GPT or OpenAI)
OPENAI_API_KEY=

# Gap GPT: set to 1 or true (API key from gapgpt.app)
USE_GAPGPT=1
# Optional: Gap GPT base URL (default https://api.gapgpt.app/v1; CDN: https://api.gapapi.com/v1)
# GAPGPT_BASE_URL=https://api.gapgpt.app/v1

# If not using Gap GPT: OpenAI-compatible base URL (leave empty for api.openai.com)
CHAT_API_BASE_URL=

# Model: gpt-4o, gpt-4o-mini, gemini-2.5-pro, etc.
CHAT_MODEL=gpt-4o

# Claude (Anthropic) optional chat page
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest
# CLAUDE_BASE_URL=https://api.anthropic.com/v1/messages

# Local LLM fallback (no API key needed) via Ollama
OLLAMA_ENABLED=1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SEC=25

# Optional: existing backend env vars
# ADMIN_TOKEN=
# BOT_API_KEY=
# PORT=5000

# Password reset email (SMTP)
FRONTEND_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
